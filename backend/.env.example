# Copy to .env (or export these directly) before running the backend.
# All of these come from the Supabase dashboard: Project Settings -> Database / API.

# Project Settings -> Database -> Connection string. Values only: the backend
# builds the JDBC URL itself, so SUPABASE_DB_HOST is a bare hostname.
# The direct host (db.<project-ref>.supabase.co) is IPv6-only; on networks
# without IPv6 use the "Session pooler" instead:
#   SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
#   SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<database-password>

# Project Settings -> API -> Project URL. Used to fetch the JWKS that verifies
# Supabase-issued tokens — this backend never signs its own.
SUPABASE_URL=https://<project-ref>.supabase.co

# platform.openai.com/api-keys. Used server-side only for question
# generation — never sent to the frontend.
OPENAI_API_KEY=<openai-api-key>
# Optional: defaults to gpt-4o-mini if omitted.
OPENAI_MODEL=gpt-4o-mini
