# Copy to .env and fill in from the Supabase dashboard: Project Settings -> API.
# The anon/public key is safe to ship in client-side code — Row Level Security
# on the database is what actually restricts what it can do.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Spring backend (teacher API). Optional — defaults to http://localhost:8080.
# On Vercel it's "/": the backend is served from the same domain under /api.
VITE_API_URL=http://localhost:8080
